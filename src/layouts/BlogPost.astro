---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleSchema from '../components/ArticleSchema.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, intent } = Astro.props;

const slotHtml = await Astro.slots.render('default');
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} type="article" image={heroImage} />
		<ArticleSchema title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} image={heroImage} />
		<style is:global>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-width: 1020px;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.date-label {
				font-weight: 600;
			}
			.last-updated-on {
				margin-top: 0.25em;
			}
		</style>
		<style is:global>
			.prose h2 {
				position: relative;
				font-size: 1.35rem;
				font-weight: 800;
				margin: 2.5rem 0 1rem;
				padding: 0.65rem 1rem 0.65rem 1.1rem;
				background: linear-gradient(135deg, #F5EEFF, #FFF0F8);
				border-left: 5px solid #9B59B6;
				border-radius: 0 10px 10px 0;
				color: #3D1A6E;
			}
			.prose h3 {
				font-size: 1.1rem;
				font-weight: 700;
				margin: 2rem 0 0.6rem;
				padding: 0 0 0.35rem 0.8rem;
				border-left: 3px solid #FF69B4;
				color: #6B3FA0;
			}
		</style>
		<style is:global>
			.faq-q {
				background: linear-gradient(135deg, #F0E6FF, #FAF0FF);
				border-left: 4px solid #9B59B6;
				border-radius: 10px;
				padding: 0.85rem 1.1rem;
				margin: 1.5rem 0 0.3rem !important;
				font-weight: 700;
				font-size: 1rem;
				color: #6B3FA0;
			}
			.faq-a {
				background: #FFF8FE;
				border: 1px solid #F0C8E0;
				border-left: 4px solid #FF69B4;
				border-radius: 10px;
				padding: 0.85rem 1.1rem;
				margin: 0 0 0.5rem !important;
				font-size: 0.97rem;
				line-height: 1.8;
			}
		</style>
		<style is:global>
			.summary-box {
				background: #F0E6FF;
				border-left: 4px solid #FF69B4;
				border-radius: 8px;
				padding: 1rem 1.5rem;
				margin: 1.5rem 0;
			}
			.summary-box ul {
				padding-left: 1.2rem;
				margin: 0.5rem 0;
			}
			.summary-box li {
				font-size: 0.9rem;
				line-height: 1.6;
				margin-bottom: 0.3rem;
			}
			@media (max-width: 768px) {
				.summary-box {
					padding: 0.75rem 1rem;
				}
				.summary-box li {
					font-size: 0.85rem;
				}
			}
			.toc {
				background: #FAF0FF;
				border: 1px solid #C8A8E9;
				border-radius: 8px;
				padding: 1rem 1.5rem;
				margin: 1.5rem 0;
			}
			.cta-box {
				background: linear-gradient(135deg, #C8A8E9, #FF69B4);
				border-radius: 12px;
				padding: 1.5rem;
				text-align: center;
				margin: 2rem 0;
				color: white;
			}
			.cta-box a {
				background: white;
				color: #9B59B6;
				padding: 12px 32px;
				border-radius: 50px;
				font-weight: bold;
				text-decoration: none;
				display: inline-block;
				margin-top: 0.5rem;
			}
			/* 予約の案内ボックス（ホテル・レストラン）。プログラムは修飾クラスで切り替え：
			   aff-box--agoda / aff-box--travelist / aff-box--ikyu */
			.aff-box {
				--aff-color: #2B6CB0;
				--aff-bg: #F2F7FD;
				--aff-icon: '🏨';
				background: var(--aff-bg);
				border: 1px solid color-mix(in srgb, var(--aff-color) 30%, white);
				border-left: 4px solid var(--aff-color);
				border-radius: 10px;
				padding: 1rem 1.2rem;
				margin: 1.5rem 0;
				font-size: 0.95rem;
				line-height: 1.7;
			}
			.aff-box a {
				display: inline-block;
				margin-top: 0.5rem;
				padding: 9px 22px;
				border-radius: 50px;
				background: var(--aff-color);
				color: white;
				font-weight: bold;
				font-size: 0.92rem;
				text-decoration: none;
				line-height: 1.5;
			}
			.aff-box::before {
				content: var(--aff-icon);
				margin-right: 0.35em;
			}
			.aff-box > img {
				display: block;
				width: 1px;
				height: 1px;
				margin: 0;
			}
			.aff-box a:hover {
				opacity: 0.88;
			}
			.aff-box--agoda {
				--aff-color: #2B6CB0;
				--aff-bg: #F2F7FD;
				--aff-icon: '🏨';
			}
			.aff-box--travelist {
				--aff-color: #1F8A7A;
				--aff-bg: #EFF8F6;
				--aff-icon: '🛏';
			}
			.aff-box--ikyu {
				--aff-color: #3D3A5C;
				--aff-bg: #F5F4F8;
				--aff-icon: '🍽';
			}
			/* 本文中のインスタベースの cta（Markdown では引用 > の形）を、aff-box と同じ箱にする。
			   A8 のリンクを含む blockquote だけが対象。ふつうの引用は global.css の見た目のまま */
			.prose blockquote:has(a[href*="px.a8.net"]) {
				--aff-color: #FF69B4;
				--aff-bg: #FFF3FA;
				--aff-icon: '🏠';
				background: var(--aff-bg);
				border: 1px solid color-mix(in srgb, var(--aff-color) 30%, white);
				border-left: 4px solid var(--aff-color);
				border-radius: 10px;
				padding: 1rem 1.2rem;
				margin: 1.5rem 0;
				font-size: 0.95rem;
				line-height: 1.7;
			}
			.prose blockquote:has(a[href*="px.a8.net"]) p {
				margin: 0;
			}
			.prose blockquote:has(a[href*="px.a8.net"]) p::before {
				content: var(--aff-icon);
				margin-right: 0.35em;
			}
			.prose blockquote:has(a[href*="px.a8.net"]) a {
				display: table;
				margin-top: 0.5rem;
				padding: 9px 22px;
				border-radius: 50px;
				background: linear-gradient(135deg, #C8A8E9, #FF69B4);
				color: white;
				font-weight: bold;
				font-size: 0.92rem;
				text-decoration: none;
				line-height: 1.5;
			}
			.prose blockquote:has(a[href*="px.a8.net"]) a:hover {
				opacity: 0.88;
			}
			.prose blockquote:has(a[href*="px.a8.net"]) img[width="1"] {
				position: absolute;
				width: 1px;
				height: 1px;
			}
			/* 広告の箱に小さく「PR」を表示（冒頭・末尾の cta-box、aff-box、本文中のインスタベースの箱） */
			.cta-box,
			.aff-box,
			.prose blockquote:has(a[href*="px.a8.net"]) {
				position: relative;
			}
			.aff-box,
			.prose blockquote:has(a[href*="px.a8.net"]) {
				padding-top: 1.4rem;
			}
			.cta-box::after,
			.aff-box::after,
			.prose blockquote:has(a[href*="px.a8.net"])::after {
				content: 'PR';
				position: absolute;
				top: 6px;
				right: 8px;
				padding: 1px 5px;
				border-radius: 4px;
				background: rgba(255, 255, 255, 0.85);
				color: #888;
				font-size: 10px;
				font-weight: normal;
				line-height: 1.4;
				letter-spacing: 0.05em;
			}
			@media (max-width: 768px) {
				.aff-box,
				.prose blockquote:has(a[href*="px.a8.net"]) {
					padding: 1.3rem 0.8rem 0.85rem;
					font-size: 0.9rem;
				}
				.aff-box a,
				.prose blockquote:has(a[href*="px.a8.net"]) a {
					display: block;
					text-align: center;
					padding: 10px 6px;
					font-size: 0.85rem;
					text-wrap: balance;
				}
				/* 「レンタルスペースを探す（インスタベース）」は1行に入らないので、
				   文字の幅を絞って「探す」と「（インスタベース）」の間で折り返す */
				.prose blockquote:has(a[href*="px.a8.net"]) a {
					text-wrap: wrap;
					padding-inline: max(6px, calc((100% - 11.5em) / 2));
				}
			}
			.nonoka-comment {
				display: flex;
				align-items: flex-start;
				gap: 12px;
				margin: 1.5rem 0;
			}
			.nonoka-comment img {
				width: 60px;
				height: 60px;
				border-radius: 50%;
				object-fit: cover;
			}
			.nonoka-comment .bubble {
				background: #FFF0F8;
				border: 2px solid #FF69B4;
				border-radius: 16px;
				padding: 0.75rem 1rem;
				position: relative;
				font-size: 0.9rem;
			}
			.nonoka-comment .bubble::before {
				content: '';
				position: absolute;
				left: -12px;
				top: 50%;
				transform: translateY(-50%);
				border-width: 8px 12px 8px 0;
				border-style: solid;
				border-color: transparent #FF69B4 transparent transparent;
			}
			.nonoka-comment .bubble::after {
				content: '';
				position: absolute;
				left: -9px;
				top: 50%;
				transform: translateY(-50%);
				border-width: 7px 11px 7px 0;
				border-style: solid;
				border-color: transparent #FFF0F8 transparent transparent;
			}
			@media (max-width: 768px) {
				.nonoka-comment {
					flex-direction: column;
				}
				.nonoka-comment img {
					width: 40px;
					height: 40px;
				}
				.nonoka-comment .bubble {
					width: 100%;
				}
				.nonoka-comment .bubble::before {
					left: 20px;
					top: -12px;
					transform: none;
					border-width: 0 8px 12px 8px;
					border-color: transparent transparent #FF69B4 transparent;
				}
				.nonoka-comment .bubble::after {
					left: 21px;
					top: -9px;
					transform: none;
					border-width: 0 7px 11px 7px;
					border-color: transparent transparent #FFF0F8 transparent;
				}
			}
			.matome-box {
				background: #FFF8E1;
				border-left: 4px solid #FF69B4;
				border-radius: 8px;
				padding: 1rem 1.5rem;
				margin: 1.5rem 0;
			}
			.author-box {
				display: flex;
				align-items: center;
				gap: 14px;
				margin: 0 0 2rem;
				padding: 1rem 1.2rem;
				border: 1.5px solid #E0C8F0;
				border-radius: 12px;
				background: #FAF5FF;
			}
			.author-icon {
				width: 56px;
				height: 56px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}
			.author-name {
				font-weight: bold;
				font-size: 0.95rem;
			}
			.author-desc {
				font-size: 0.8rem;
				color: #888;
			}
			.author-bio {
				font-size: 0.8rem;
				color: #666;
				margin-top: 4px;
				line-height: 1.5;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image src={heroImage} widths={[390, 780, 1020]} sizes="(max-width: 768px) 92vw, 1020px" alt={heroImageAlt ?? ''} loading="eager" fetchpriority="high" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="date">
							<span class="date-label">公開日：</span><FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										<span class="date-label">更新日：</span><FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<hr />
					</div>
					<div class="author-box">
						<img src="/images/nonoka-icon.png" alt="ののか" class="author-icon">
						<div class="author-info">
							<div class="author-name">ののか</div>
							<div class="author-desc">おでかけ好きの案内役</div>
							<div class="author-bio">東京の回り方や、ちょっと休める場所を一緒に考えます。</div>
						</div>
					</div>
					<Fragment set:html={slotHtml} />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// FAQ Q/A styling
			document.querySelectorAll('.prose p').forEach(p => {
				const text = p.textContent.trim();
				if (/^Q[.．]/.test(text)) {
					p.classList.add('faq-q');
				} else if (/^A[.．]/.test(text)) {
					p.classList.add('faq-a');
				}
			});
		</script>
	</body>
</html>
