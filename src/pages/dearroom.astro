---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const RESERVE_URL = 'https://www.spacemarket.com/p/AHbhuUbilSKvoqCw'; // TODO: Square予約URLに変更
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="DEARROOM六本木の設備・料金｜100インチの貸切シネマルーム"
      description="六本木の貸切シネマルームDEARROOM。100インチの大画面、Dolby Atmos対応の音響、推し色に変えられるLEDで、推し活・スポーツ観戦・映画・打ち上げの夜を。最大10名まで同料金、24時間利用OK。"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'DEARROOM六本木',
      description: '六本木の貸切シネマルーム。100インチスクリーンとDolby Atmos対応の音響、推し色に変えられるLEDを備え、推し活・スポーツ観戦・映画鑑賞・打ち上げなど、仲間と過ごす特別な時間に利用できます。',
      url: 'https://www.oshikatsu-room.com/dearroom/',
      image: new URL('/images/dearroom/room-cinema.png', Astro.site).toString(),
      address: {
        '@type': 'PostalAddress',
        streetAddress: '六本木4丁目1-27 三河台ハウス202号室',
        addressLocality: '港区',
        addressRegion: '東京都',
        postalCode: '106-0032',
        addressCountry: 'JP',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '00:00',
        closes: '23:59',
      },
      priceRange: '¥¥',
      maximumAttendeeCapacity: 10,
    })} />
  </head>
  <body class="dr-body">
    <Header />

    <!-- ① HERO -->
    <section class="dr-hero">
      <div class="dr-hero-bg">
        <img src="/images/dearroom/room-cinema.png" alt="DEARROOM シネマルーム" class="dr-hero-img" />
        <div class="dr-hero-overlay"></div>
      </div>
      <div class="dr-hero-content">
        <p class="dr-hero-eyebrow">六本木の貸切シネマルーム</p>
        <h1 class="dr-hero-title">好きなものに、<br />好きな人たちと。</h1>
        <p class="dr-hero-sub">100インチの大画面と、部屋を包む音。推し色に変わる光。<br />誰にも気兼ねなく、好きなものに没頭できる夜を過ごしませんか。</p>
        <div class="dr-hero-ratings">
          <span>⭐ 4.9 インスタベース</span>
          <span>⭐ 4.6 スペースマーケット</span>
        </div>
        <a href={RESERVE_URL} target="_blank" rel="noopener noreferrer" class="dr-btn-primary dr-hero-btn">この部屋で過ごす日を選ぶ</a>
        <p class="dr-btn-note dr-btn-note-hero">24時間利用OK・最大10名まで人数追加料金なし</p>
      </div>
    </section>

    <!-- ② こんな夜を、過ごせます -->
    <section class="dr-section dr-nights">
      <div class="dr-container">
        <h2 class="dr-section-title">こんな夜を、過ごせます</h2>
        <p class="dr-section-lead">推しのお祝いも、深夜の試合も、映画館を貸し切ったような映画会も。DEARROOMでは、実際にこんな時間が過ごされています。</p>
        <div class="dr-nights-grid">
          <a class="dr-night-card" href="/blog/oshi-seitansai-kanzen-guide/">
            <div class="dr-night-img"><img src="/images/dearroom/room-red.png" alt="推し色に染めた部屋" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">🎂</span>推しの誕生日を、推し色の部屋で</h3>
              <p>部屋じゅうを推しのメンバーカラーに染めて、祭壇を飾って、ケーキで乾杯。いつもの生誕祭が、忘れられない一日になります。</p>
              <span class="dr-night-link">推しの生誕祭 完全ガイド →</span>
            </div>
          </a>
          <a class="dr-night-card" href="/blog/live-haishin-dekiru-basho-hikaku/">
            <div class="dr-night-img"><img src="/images/dearroom/room-blue.png" alt="ブルーLEDの部屋で配信を観る" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">🎤</span>ライブ配信を、仲間と大画面で</h3>
              <p>配信ライブやライブBDを、100インチのスクリーンで。同じ場面で一緒に盛り上がれる仲間がいると、感動は何倍にもなります。</p>
              <span class="dr-night-link">ライブ配信できる場所の選び方 →</span>
            </div>
          </a>
          <a class="dr-night-card" href="/blog/sports-kansen-kashikiri-space/">
            <div class="dr-night-img"><img src="/images/dearroom/room-green.png" alt="グリーンLEDの部屋で試合観戦" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">⚽</span>深夜の試合を、みんなで観る</h3>
              <p>海外サッカーやワールドカップ、深夜や早朝の試合も、24時間使えるので大丈夫。DAZNやABEMAを大画面で観られます。</p>
              <span class="dr-night-link">スポーツ観戦を貸切でするならどこ？ →</span>
            </div>
          </a>
          <a class="dr-night-card" href="/blog/roppongi-date-private-cinema-room/">
            <div class="dr-night-img"><img src="/images/dearroom/room-cinema.png" alt="大画面で映画を観る部屋" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">🎬</span>映画館を貸し切るような、映画の夜</h3>
              <p>部屋を暗くして、お気に入りの映画を大画面で。飲み物やおつまみを持ち込んで、上映中に話してもいい、自分たちだけの映画館です。</p>
              <span class="dr-night-link">六本木の映画デート →</span>
            </div>
          </a>
          <a class="dr-night-card" href="/blog/roppongi-shuden-nogashita/">
            <div class="dr-night-img"><img src="/images/dearroom/room-party.png" alt="グループで過ごす部屋" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">🥂</span>打ち上げや、解散したくない夜の続きに</h3>
              <p>仕事の打ち上げや、飲み会のあとの二次会に。終電を逃した夜に、始発まで仲間と過ごす使い方もされています。</p>
              <span class="dr-night-link">六本木で終電を逃したら？ →</span>
            </div>
          </a>
          <a class="dr-night-card" href="/blog/satsuei-haishin-rental-space-roppongi/">
            <div class="dr-night-img"><img src="/images/dearroom/dearroom-cinema.png" alt="撮影・配信に使える空間" loading="lazy" /></div>
            <div class="dr-night-body">
              <h3><span class="dr-night-emoji">📸</span>撮影や配信の拠点として</h3>
              <p>推し色のLEDと大画面を背景に、写真や動画の撮影を。高速回線（NURO光）で、ライブ配信の拠点にも使えます。商用の撮影・配信は商用利用オプションをご利用ください。</p>
              <span class="dr-night-link">六本木で撮影・配信できるレンタルスペース →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ③ DEARROOMで過ごす夜の、3つのこと -->
    <section class="dr-section dr-three">
      <div class="dr-container">
        <h2 class="dr-section-title">DEARROOMで過ごす夜の、3つのこと</h2>
        <div class="dr-three-grid">
          <div class="dr-three-card">
            <div class="dr-three-num">1</div>
            <h3>非日常の大画面と、部屋を包む音</h3>
            <p>100インチのスクリーンに、Dolby Atmos対応のJBLサウンドバー。ライブの歓声も映画の音楽も、部屋全体に広がります。照明は推し色やその日の気分の色に変えられます。</p>
          </div>
          <div class="dr-three-card">
            <div class="dr-three-num">2</div>
            <h3>誰にも気兼ねしなくていい</h3>
            <p>完全貸切なので、周りの目を気にせず過ごせます。食べ物も飲み物もお酒も、飾り付けやグッズも持ち込み自由。帰るときはゴミを置いて帰れます。</p>
          </div>
          <div class="dr-three-card">
            <div class="dr-three-num">3</div>
            <h3>仲間が増えても、料金は同じ</h3>
            <p>最大10名まで、人数による追加料金はありません。人数が多いほど、一人あたりの負担は軽くなります。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ④ REVIEWS（移動・H2のみ変更） -->
    <section class="dr-section dr-reviews">
      <div class="dr-container">
        <h2 class="dr-section-title">実際に過ごした方の声</h2>
        <div class="dr-ratings-row">
          <div class="dr-rating-badge">
            <span class="dr-rating-stars">⭐⭐⭐⭐⭐</span>
            <span class="dr-rating-num">4.9</span>
            <span class="dr-rating-src">インスタベース</span>
          </div>
          <div class="dr-rating-badge">
            <span class="dr-rating-stars">⭐⭐⭐⭐⭐</span>
            <span class="dr-rating-num">4.6</span>
            <span class="dr-rating-src">スペースマーケット</span>
          </div>
        </div>

        <p class="dr-carousel-hint">← スライドして他のレビューを見る →</p>
        <div class="dr-carousel-wrap">
          <button class="dr-carousel-btn dr-carousel-prev" aria-label="前へ">‹</button>
          <div class="dr-carousel" id="reviewCarousel">
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">天井のプロジェクターの迫力があり、画面も音も迫力がありました！ソファーも大きくてゆったりとYouTubeを見ることができました。また機会があれば利用したいと思います！</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">立地がとても良く、このエリアではかなりコスパが高いと感じました。お部屋も思っていたより清潔感があり、快適に過ごすことができました。入室までの案内も丁寧でスムーズだったので、初めての利用でも安心でした。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">電車の遅延でスタジオ利用時間に到着が間に合わなかったところご連絡したら無料で30分延長していただきました。お心遣いとても有難く思いました。スタジオも落ち着いた雰囲気で心地よく過ごすことができました。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">音楽LIVEのライブ配信を友人と観るために使用しました。設備が充実していて、かつ非常に分かりやすく、とても快適に使えました。ビルがちょっと古いところが気になりましたが、こちらの部屋のせいではないので満足です☺️</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">誕生日会で利用しました。いろいろ質問させていただきましたが、返信も早くとても安心でした。工夫されていてとても使いやすいスペースでした。ゴミ引き取りオプションも良心的でとても快適に過ごすことができました。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">eスポーツの試合観戦で利用しました。回線速度も安定しており、プロジェクターの映りもよく、お部屋も綺麗で大変楽しく使わせていただきました！ごみ捨ても無料オプションで付帯できるのも大変助かりました。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">会社のお疲れ様会で利用しました。快適な絨毯とソファー、大きなスクリーンがあり、誰にも邪魔されることなくメンバーと会話をしっかり楽しむことができました。また利用したいと思います。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">清潔な空間で快適に過ごせました。利用時間中に確認事項がありホストの方にメッセージを送りましたが、迅速に返信いただき大変感謝しております。また機会があれば利用させていただきたいと思います♪</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">六本木駅から少し離れた閑静な場所。イメージ通りの部屋で綺麗でいい感じでした。やり取りもスムーズでとても使いやすかったです。値段も安く、また機会があれば利用したいと思います。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">推しのライブビューイングで6人で利用させていただきました。大きなスクリーンで映像もきれいで、すごく楽しめました！！駅からのアクセスもよく、お部屋も落ち着いた雰囲気でリラックスできました。</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">内装がとても良く、プロジェクターも綺麗に写っていて凄く楽しかったです！また機会があれば使いたいなと思う部屋でした！本当にありがとうございました！</p>
            </div>
            <div class="dr-rcard">
              <p class="dr-rcard-stars">⭐⭐⭐⭐⭐</p>
              <p class="dr-rcard-text">撮影で使用させて頂きました！とても素敵なお部屋で気分良く取り組む事が出来ました！また利用させて頂きたいです！</p>
            </div>
          </div>
          <button class="dr-carousel-btn dr-carousel-next" aria-label="次へ">›</button>
        </div>
      </div>
    </section>

    <!-- ⑤ たとえば、こんな3時間 -->
    <section class="dr-section dr-timeline">
      <div class="dr-container">
        <h2 class="dr-section-title">たとえば、こんな3時間</h2>
        <p class="dr-section-lead">6人で推しの誕生日をお祝いする、週末の夜の一例です。</p>
        <ul class="dr-timeline-list">
          <li><span class="dr-timeline-time">18:00</span><span class="dr-timeline-text">集合。持ち寄ったバルーンやグッズで祭壇を飾る</span></li>
          <li><span class="dr-timeline-time">18:30</span><span class="dr-timeline-text">LEDを推しのメンバーカラーに変えて、準備完了</span></li>
          <li><span class="dr-timeline-time">19:00</span><span class="dr-timeline-text">乾杯、ケーキでお祝い</span></li>
          <li><span class="dr-timeline-time">19:30</span><span class="dr-timeline-text">ライブBDを100インチの大画面で。みんなで盛り上がる</span></li>
          <li><span class="dr-timeline-time">20:45</span><span class="dr-timeline-text">片付け。ゴミはまとめて置いて帰れます</span></li>
          <li><span class="dr-timeline-time">21:00</span><span class="dr-timeline-text">退室</span></li>
        </ul>
        <p class="dr-timeline-note">週末3時間 ¥5,130 を6人で割ると、一人あたり約855円です（料金は目安です）。</p>
      </div>
    </section>

    <!-- ⑥ LED GALLERY（既存のまま） -->
    <section class="dr-section dr-gallery">
      <div class="dr-container">
        <h2 class="dr-section-title">推し色に染まる<span class="dr-accent">空間</span></h2>
        <p class="dr-section-sub">LEDカラーは自由に変更できます</p>
        <div class="dr-gallery-grid">
          <div class="dr-gallery-item">
            <img src="/images/dearroom/room-blue.png" alt="ブルーLED" />
            <span class="dr-gallery-label">ブルー</span>
          </div>
          <div class="dr-gallery-item dr-gallery-main">
            <img src="/images/dearroom/room-party.png" alt="グループ利用" />
            <span class="dr-gallery-label">みんなで推し活</span>
          </div>
          <div class="dr-gallery-item">
            <img src="/images/dearroom/room-red.png" alt="レッドLED" />
            <span class="dr-gallery-label">レッド</span>
          </div>
          <div class="dr-gallery-item">
            <img src="/images/dearroom/room-green.png" alt="グリーンLED" />
            <span class="dr-gallery-label">グリーン</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ⑦ この夜を支える設備 -->
    <section class="dr-section dr-specs">
      <div class="dr-container">
        <h2 class="dr-section-title">この夜を支える<span class="dr-accent">設備</span></h2>
        <div class="dr-specs-grid">
          <div class="dr-specs-card">
            <h3>映像・音響</h3>
            <ul>
              <li>100インチ大型スクリーン（4Kプロジェクター）</li>
              <li>JBL BAR 800（Dolby Atmos対応）</li>
              <li>Netflix・Prime Video・YouTube・DAZN・ABEMAに対応（ご自身のアカウントでログイン）</li>
              <li>HDMI・ミラーリングで、スマホやPCの映像も映せます</li>
            </ul>
          </div>
          <div class="dr-specs-card">
            <h3>空間</h3>
            <ul>
              <li>広さ24㎡（約15畳）、最大10名</li>
              <li>推し色に変えられるLEDライティング</li>
              <li>完全貸切の個室</li>
              <li>ボードゲームあり</li>
            </ul>
          </div>
          <div class="dr-specs-card">
            <h3>キッチン・通信</h3>
            <ul>
              <li>キッチン（IHコンロ）・冷蔵庫・電子レンジ</li>
              <li>高速Wi-Fi（NURO光。実測 下り約592Mbps／上り約576Mbps）</li>
              <li>延長コードあり</li>
            </ul>
          </div>
          <div class="dr-specs-card">
            <h3>ご利用条件</h3>
            <ul>
              <li>24時間利用可能</li>
              <li>3時間単位から予約可能</li>
              <li>飲食物・お酒の持ち込み自由（匂いの強いものはご遠慮ください）</li>
              <li>ゴミ処理無料</li>
              <li>商用利用（撮影・配信など）は商用利用オプション（8,500円）</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ⑧ PRICING -->
    <section class="dr-section dr-pricing">
      <div class="dr-container">
        <h2 class="dr-section-title">料金プラン</h2>
        <p class="dr-section-sub">すべて最大10名まで同料金</p>
        <div class="dr-pricing-grid">
          <div class="dr-pricing-card">
            <div class="dr-pricing-head">
              <span class="dr-pricing-badge">平日デイ</span>
              <p class="dr-pricing-note">〜18:00</p>
            </div>
            <ul class="dr-pricing-list">
              <li><span>3時間</span><strong>¥3,510</strong></li>
              <li><span>6時間</span><strong>¥7,020</strong></li>
              <li><span>9時間</span><strong>¥10,530</strong></li>
            </ul>
          </div>
          <div class="dr-pricing-card">
            <div class="dr-pricing-head">
              <span class="dr-pricing-badge">平日ナイト</span>
              <p class="dr-pricing-note">18:00〜</p>
            </div>
            <ul class="dr-pricing-list">
              <li><span>3時間</span><strong>¥4,050</strong></li>
              <li><span>6時間</span><strong>¥8,100</strong></li>
              <li><span>9時間</span><strong>¥12,150</strong></li>
            </ul>
          </div>
          <div class="dr-pricing-card dr-pricing-featured">
            <div class="dr-pricing-head">
              <span class="dr-pricing-badge">週末・祝日</span>
              <p class="dr-pricing-note">終日</p>
            </div>
            <ul class="dr-pricing-list">
              <li><span>3時間</span><strong>¥5,130</strong></li>
              <li><span>6時間</span><strong>¥10,260</strong></li>
              <li><span>9時間</span><strong>¥15,390</strong></li>
            </ul>
          </div>
        </div>
