---
import { Image, Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import dearroomCinema from '../assets/dearroom-cinema.png';
import heroRoom from '../assets/hero-room.jpg';

const RESERVE_URL = 'https://www.spacemarket.com/p/AHbhuUbilSKvoqCw';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 最新の記事（公開日の新しい順に6本）
const latestPosts = allPosts.slice(0, 6);

// サムネ画像がない記事用の短い見出し（タイトルを端的に。最初の ｜ の前／最初の ？ まで）
const thumbLabel = (title: string) => {
	let s = title.split(/[｜|]/)[0].trim();
	const q = s.search(/[？?]/);
	if (q !== -1) s = s.slice(0, q + 1);
	return s;
};

// カテゴリから探す（リンク先は各テーマの完全ガイド記事）
const CATEGORIES = [
	{ mod: 'birthday', name: '生誕祭・推しの誕生日', desc: '祭壇づくりから当日の演出まで', href: '/blog/oshi-seitansai-kanzen-guide/' },
	{ mod: 'date', name: '六本木デート', desc: '夜景・ディナー・雨の日プラン', href: '/blog/roppongi-date-kanzen-guide/' },
	{ mod: 'streaming', name: '配信・撮影', desc: '映える撮影・配信のコツと機材', href: '/blog/live-haishin-dekiru-basho-hikaku/' },
	{ mod: 'party', name: '貸切・パーティー', desc: 'オフ会・女子会・記念日の貸切', href: '/blog/roppongi-kashikiri-party-space/' },
];

// カテゴリカードのアイコン（ヒーローの丸アイコンと同系統の線画SVG。色はCSSでcategoryごとに指定）
const CATEGORY_ICONS = {
	birthday: '<svg class="home-category-card__shape" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5h17"/><path d="M5 20.5v-6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6"/><path d="M5 16c1.4 1.4 2.5 1.4 3.9 0s2.5-1.4 3.9 0 2.5 1.4 3.9 0 2.5-1.4 3.3-.4"/><path d="M12 9V7"/><circle cx="12" cy="5" r="1"/></svg>',
	date: '<svg class="home-category-card__shape" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.3S3.8 15.4 3.8 9.6A4 4 0 0 1 12 7.2 4 4 0 0 1 20.2 9.6C20.2 15.4 12 20.3 12 20.3Z"/></svg>',
	streaming: '<svg class="home-category-card__shape" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.5h3l1.4-2.2h7.2L17 8.5h3a1 1 0 0 1 1 1v8.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3"/></svg>',
	party: '<svg class="home-category-card__shape" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l2 6.2a2.4 2.4 0 0 0 4.6 0L14.6 3"/><path d="M10 12v6"/><path d="M6.5 21h7"/><path d="M17 4l3.5 1-1 3.5"/></svg>',
};

// 特集バナー（生誕祭ガイド。画像は記事の heroImage を使用）
const featured = allPosts.find((post) => post.id === 'oshi-seitansai-kanzen-guide');

// 人気の記事（手動指定・当面固定。タイトルとheroImageはコレクションから取得）
const POPULAR = [
	{ slug: 'azabudai-hills-date', chip: '六本木デート' },
	{ slug: 'oshi-seitansai-kanzen-guide', chip: '生誕祭' },
	{ slug: 'roppongi-oshi-katsu-cafe-vs-private-room', chip: '推し活' },
];
const popularPosts = POPULAR.map((p) => {
	const entry = allPosts.find((post) => post.id === p.slug);
	return entry ? { chip: p.chip, entry } : null;
}).filter((p) => p !== null);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="DEARROOM六本木｜推し活・観戦・映画を楽しむ貸切シネマルーム"
			description="推しの生誕祭・誕生日会・ライブ鑑賞会の場所選びに悩んでいませんか？六本木でシネマルームを運営するののかが、推し活をもっと豊かにする場所選び・飾り付け・お金の使い方を発信しています。"
		/>
		{/* トップページのみ WebSite 構造化データ */}
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'DEARROOM六本木',
			alternateName: ['DEARROOM', 'ディアルーム六本木'],
			url: 'https://www.oshikatsu-room.com/',
		})} />
		{/* 見出し用フォント（このページのみ読み込み。CJKは preload すると全サブセットDLになるため付けない） */}
		<Font cssVariable="--font-shippori-mincho" />
	</head>
	<body>
		<section class="hero">
			<div class="hero__bg">
				<Image class="hero__bgimg" src={heroRoom} alt="DEARROOM六本木のシネマルーム" widths={[640, 1024, 1536]} sizes="100vw" loading="eager" fetchpriority="high" />
			</div>
			<div class="hero__overlay" aria-hidden="true"></div>

			{/* 画像に焼き込まれたロゴへの透明トップリンク（左上） */}
			<a href="/" class="hero__logolink" aria-label="DEARROOM トップ"></a>

			{/* タグライン（焼き込みロゴの直下・PCのみ） */}
			<p class="hero__tagline">集まる、つながる、好きがひろがる。</p>

			{/* 透明ナビ（右上） */}
			<nav class="hero__nav" aria-label="メインナビゲーション">
				<ul class="hero__navlinks">
					<li><a href="/">トップ</a></li>
					<li><a href="/blog/">記事一覧</a></li>
					<li><a href="/dearroom/">設備・料金</a></li>
				</ul>
				<a class="hero__navcta" href={RESERVE_URL} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
					予約する
				</a>
			</nav>

			<div class="hero__content">
				<h1 class="hero-h1">
					<span class="hero-h1-main">ここで、<br><span class="hero-h1-hl">好きな時間</span>を<br>過ごそう。</span>
					<span class="hero-h1-sub">六本木のレンタルスペース DEARROOM</span>
				</h1>

				<p class="hero__subcopy">くつろぎも、楽しさも、あなた次第。</p>

				<ul class="hero__icons">
					<li>
						<a href="/blog/oshi-seitansai-kanzen-guide/">
							<span class="hero__icon-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5h17"/><path d="M5 20.5v-6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6"/><path d="M5 16c1.4 1.4 2.5 1.4 3.9 0s2.5-1.4 3.9 0 2.5 1.4 3.9 0 2.5-1.4 3.3-.4"/><path d="M12 9V7"/><circle cx="12" cy="5" r="1"/></svg></span>
							<span class="hero__icon-label">推し活・生誕祭</span>
						</a>
					</li>
					<li>
						<a href="/blog/roppongi-kashikiri-party-space/">
							<span class="hero__icon-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l2 6.2a2.4 2.4 0 0 0 4.6 0L14.6 3"/><path d="M10 12v6"/><path d="M6.5 21h7"/><path d="M17 4l3.5 1-1 3.5"/></svg></span>
							<span class="hero__icon-label">パーティー</span>
						</a>
					</li>
					<li>
						<a href="/blog/satsuei-haishin-rental-space-roppongi/">
							<span class="hero__icon-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M8.8 8.8a4.5 4.5 0 0 0 0 6.4"/><path d="M15.2 8.8a4.5 4.5 0 0 1 0 6.4"/><path d="M6.3 6.3a8 8 0 0 0 0 11.4"/><path d="M17.7 6.3a8 8 0 0 1 0 11.4"/></svg></span>
							<span class="hero__icon-label">ライブ配信</span>
						</a>
					</li>
					<li>
						<a href="/dearroom/">
							<span class="hero__icon-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7.5" width="12" height="9" rx="2"/><path d="M15 10.3l5.5-2.8v9l-5.5-2.8z"/></svg></span>
							<span class="hero__icon-label">映画鑑賞</span>
						</a>
					</li>
				</ul>

				<a class="hero__cta" href={RESERVE_URL} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
					<span>この部屋で過ごす日を選ぶ</span>
					<span class="hero__cta-arrow" aria-hidden="true">›</span>
				</a>
				<p class="hero__cta-note">24時間利用OK・最大10名まで人数追加料金なし</p>
			</div>

			{/* 右側の手書きコピー（PCのみ） */}
			<div class="hero__handwrite" aria-hidden="true">
				<p class="hero__hw hero__hw--top">
					集まる、<br>くつろぐ、<br>叶う場所♡
					<svg class="hero__hw-line" viewBox="0 0 170 12" preserveAspectRatio="none"><path d="M3 6.5 C 46 11, 112 3.5, 167 5 C 116 6.4, 50 9.2, 3 8 Z" fill="currentColor" /></svg>
				</p>
				<p class="hero__hw hero__hw--bottom">
					いつもの日常を、<br>ちょっと特別に。
					<svg class="hero__hw-line" viewBox="0 0 170 12" preserveAspectRatio="none"><path d="M3 6.5 C 46 11, 112 3.5, 167 5 C 116 6.4, 50 9.2, 3 8 Z" fill="currentColor" /></svg>
				</p>
			</div>

			{/* 左下のブランド表記 */}
		</section>

		<main class="home-main">
			<!-- 1. カテゴリから探す -->
			<section class="home-category">
				<div class="home-category__inner">
					<ul class="home-category__grid">
						{
							CATEGORIES.map((c) => (
								<li>
									<a href={c.href} class={`home-category-card home-category-card--${c.mod}`}>
										<span class="home-category-card__icon"><Fragment set:html={CATEGORY_ICONS[c.mod]} /></span>
										<span class="home-category-card__body">
											<span class="home-category-card__name">{c.name}</span>
											<span class="home-category-card__desc">{c.desc}</span>
										</span>
										<span class="home-category-card__meta"><span class="home-category-card__arrow">→</span></span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- 特集バナー -->
			{
				featured && featured.data.heroImage && (
					<section class="home-feature">
						<div class="home-feature__inner">
							<a href={`/blog/${featured.id}/`} class="home-feature__link">
								<Image src={featured.data.heroImage} widths={[390, 780, 1120]} sizes="(max-width: 768px) 92vw, 1120px" alt={featured.data.title} loading="lazy" />
							</a>
						</div>
					</section>
				)
			}

			<!-- 2. 人気の記事 -->
			<section class="home-popular">
				<div class="home-popular__inner">
					<header class="home-popular__head">
						<div class="home-section-title">
							<span class="home-section-title__eyebrow">POPULAR</span>
							<h2 class="home-section-title__heading">人気の記事</h2>
							<p class="home-section-title__lead">よく読まれている、推し活の定番ガイド</p>
						</div>
					</header>

					<ul class="home-popular__grid">
						{
							popularPosts.map((p) => (
								<li>
									<a href={`/blog/${p.entry.id}/`} class="home-popular-card">
										<div class="home-popular-card__media">
											{p.entry.data.heroImage ? (
												<Image src={p.entry.data.heroImage} widths={[360, 720]} sizes="(max-width: 768px) 92vw, 360px" alt="" loading="lazy" />
											) : (
												<div class="home-popular-card__noimage">
													<span class="home-popular-card__noimage-label">RECOMMENDED</span>
													<span class="home-popular-card__noimage-text">{p.chip}のおすすめ記事</span>
												</div>
											)}
										</div>
										<div class="home-popular-card__body">
											<span class="home-chip">{p.chip}</span>
											<h3 class="home-popular-card__title">{p.entry.data.title}</h3>
											<div class="home-popular-card__date">
												<FormattedDate date={p.entry.data.pubDate} />
											</div>
										</div>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- 3. 最新の記事 -->
			<section class="home-latest">
				<div class="home-latest__inner">
					<div class="home-section-title">
						<span class="home-section-title__eyebrow">NEW ARTICLES</span>
						<h2 class="home-section-title__heading">最新の記事</h2>
					</div>

					<ul class="home-latest__grid">
						{
							latestPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`} class="home-latest-card">
										<div class="home-latest-card__media">
											{post.data.heroImage ? (
												<Image src={post.data.heroImage} widths={[96, 192, 420]} sizes="(max-width: 768px) 92vw, 96px" alt="" loading="lazy" />
											) : (
												<div class="home-latest-card__noimage">{thumbLabel(post.data.title)}</div>
											)}
										</div>
										<div class="home-latest-card__body">
											<div class="home-latest-card__meta">
												<FormattedDate date={post.data.pubDate} />
											</div>
											<h3 class="home-latest-card__title">{post.data.title}</h3>
										</div>
									</a>
								</li>
							))
						}
					</ul>

					<div class="home-latest__more">
						<a href="/blog/" class="home-button-outline">記事一覧を見る <span class="home-button-outline__arrow">→</span></a>
					</div>
				</div>
			</section>

			<!-- 4. DEARROOMについて -->
			<section class="home-about">
				<div class="home-about__inner">
					<div class="home-about__card">
						<div class="home-about__media">
							<Image src={dearroomCinema} widths={[400, 800, 1040]} sizes="(max-width: 768px) 92vw, 520px" alt="DEARROOM 六本木 シネマルーム" loading="lazy" />
						</div>
						<div class="home-about__body">
							<span class="home-section-title__eyebrow">ABOUT DEARROOM</span>
							<h2 class="home-about__heading">このマガジンを運営する、<br>六本木のシネマルーム</h2>
							<p class="home-about__text">DEARROOM六本木は、推しの生誕祭やデート、配信・撮影に使える完全個室のプライベートシネマルームです。100インチのスクリーンとDolby Atmos対応の音響で、ふたりでも仲間とでも特別な時間を過ごせます。</p>
							<ul class="home-about__features">
								<li>100インチスクリーン</li>
								<li>六本木駅 徒歩6分</li>
								<li>最大10名まで</li>
							</ul>
							<a href="/dearroom/" class="home-about__link">DEARROOMについて詳しく <span class="home-about__arrow">→</span></a>
						</div>
					</div>
				</div>
			</section>

			<!-- 5. 予約CTA -->
			<section class="home-reserve">
				<span class="home-section-title__eyebrow home-section-title__eyebrow--light">RESERVATION</span>
				<h2 class="home-reserve__heading">推し活の舞台を、六本木で。</h2>
				<div class="home-reserve__text">
					<p class="home-reserve__lead">空き状況はカレンダーからすぐに確認できます</p>
					<p class="home-reserve__note">※ボタンを押すと予約サイト「スペースマーケット」に移動します</p>
				</div>
				<a href={RESERVE_URL} class="home-reserve__button" target="_blank" rel="noopener noreferrer">DEARROOM六本木を予約する</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	/* ホームは全幅レイアウト（global.css の main 制約をリセット） */
	.home-main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	/* ===== HERO（左寄せ・参考デザイン準拠） ===== */
	.hero {
		position: relative;
		overflow: hidden;
		min-height: 100vh;
		display: flex;
		align-items: center;
		color: #fff;
		/* 焼き込みロゴ下端の実測位置（元画像で縦15.6%）。cover表示は幅/高さの大きい方でスケールする */
		--logo-bottom: max(10.42vw, 15.63vh);
	}

	/* 背景（焼き込みロゴ入り写真。左上を基準にしてロゴを常に表示） */
	.hero__bg { position: absolute; inset: 0; z-index: 0; }
	.hero__bgimg {
		width: 100%; height: 100%;
		object-fit: cover;
		object-position: left top;
		display: block;
	}
	/* 文字が乗る左下～中央左だけを濃く。ロゴ（左上）と室内（右）はほぼ透明にして写真の暖かみを残す */
	.hero__overlay {
		position: absolute; inset: 0; z-index: 1;
		background:
			radial-gradient(78% 82% at 4% 92%, rgba(6, 4, 8, 0.86) 0%, rgba(6, 4, 8, 0.5) 30%, rgba(6, 4, 8, 0.14) 58%, rgba(6, 4, 8, 0) 80%),
			radial-gradient(72% 58% at 0% 52%, rgba(6, 4, 8, 0.5) 0%, rgba(6, 4, 8, 0.16) 46%, rgba(6, 4, 8, 0) 72%),
			linear-gradient(180deg, rgba(6, 4, 8, 0) 62%, rgba(6, 4, 8, 0.22) 100%);
	}

	/* 焼き込みロゴへの透明トップリンク */
	.hero__logolink {
		position: absolute; z-index: 5;
		top: 0; left: 0;
		width: calc((var(--logo-bottom) + 10px) * 2.5);
		height: calc(var(--logo-bottom) + 10px);
	}

	/* タグライン（ロゴ直下・PCのみ） */
	.hero__tagline {
		position: absolute; z-index: 5;
		/* 焼き込みロゴ下端から 12px 下（画像スケールに連動） */
		top: calc(var(--logo-bottom) + 12px);
		left: clamp(16px, 4.6vw, 60px);
		margin: 0;
		font-family: var(--font-noto-sans-jp), sans-serif;
		font-size: clamp(0.74rem, 1.15vw, 0.92rem);
		letter-spacing: 0.06em;
		color: rgba(255, 255, 255, 0.88);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
	}

	/* 透明ナビ（右上） */
	.hero__nav {
		position: absolute; z-index: 6;
		top: 0; right: 0; left: 0;
		display: flex; align-items: center; justify-content: flex-end;
		gap: clamp(16px, 2.6vw, 36px);
		/* 天井照明を避けるため上余白を増やしてナビ全体を下げる */
		padding: clamp(24px, 3.8vw, 54px) clamp(16px, 4vw, 56px);
	}
	.hero__navlinks {
		display: flex; align-items: center; gap: clamp(16px, 2.4vw, 38px);
		list-style: none; margin: 0; padding: 0;
	}
	.hero__navlinks a {
		font-family: var(--font-noto-sans-jp), sans-serif;
		font-size: 0.95rem; font-weight: 500; color: #fff; text-decoration: none;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9), 0 0 4px rgba(0, 0, 0, 0.7);
		transition: color 0.2s;
	}
	.hero__navlinks a:hover { color: #f4c4cb; }
	.hero__navcta {
		display: inline-flex; align-items: center; gap: 8px;
		font-family: var(--font-noto-sans-jp), sans-serif;
		font-size: 0.95rem; font-weight: 700; color: #fff; text-decoration: none;
		background: #B24C5C;
		padding: 11px 26px; border-radius: 999px;
		box-shadow: 0 6px 18px rgba(180, 76, 92, 0.45);
